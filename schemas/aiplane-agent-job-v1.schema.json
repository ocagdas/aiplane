{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplane.dev/schemas/agent-job/v1",
  "title": "aiplane agent job",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "render_only",
    "name",
    "environment",
    "task",
    "target_roles",
    "workspace",
    "execution_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/aiplane-agent-job-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "agent_job"
    },
    "render_only": {
      "const": true
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "name",
        "profile",
        "source_stack",
        "orchestrator",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "source_stack": {
          "type": "string",
          "minLength": 1
        },
        "orchestrator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "target_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workspace": {
      "type": "object",
      "required": [
        "path",
        "policy"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "const": "workspace_only"
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object"
    },
    "approval_mode": {
      "type": "string"
    },
    "audit_label": {
      "type": "string"
    },
    "execution_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
