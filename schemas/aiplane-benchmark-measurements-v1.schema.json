{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplane.dev/schemas/aiplane-benchmark-measurements-v1.schema.json",
  "title": "Aiplane benchmark measurements v1",
  "type": "object",
  "required": [
    "contract_version",
    "record_type",
    "model_name",
    "suite",
    "runs",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "benchmark_measurements"
    },
    "created_at": {
      "type": "string"
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "provider": {},
    "model": {},
    "suite": {
      "type": "object",
      "required": [
        "name",
        "version",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "smoke",
            "quality",
            "performance",
            "mixed"
          ]
        },
        "comparability": {
          "type": [
            "object",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "decoding": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "repeat_index": {
            "type": "integer",
            "minimum": 1
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "quality_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "performance_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "elapsed_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "load_duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "ttft_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "prompt_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "prompt_tokens_per_second": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "telemetry_source": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "server_tokens_per_second": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Native output-token count divided by server generation duration, excluding client request overhead."
          },
          "client_tokens_per_second": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Reported output-token count divided by client-observed request duration, including request and response processing overhead."
          },
          "average_tokens_per_second": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Arithmetic mean of available server/client rates, or null when neither exists; not aggregate throughput."
          },
          "client_elapsed_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "server_elapsed_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "server_generation_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "throughput_average_sources": {
            "type": "array",
            "items": {
              "enum": [
                "server",
                "client"
              ]
            },
            "uniqueItems": true
          },
          "decoding_evidence": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string"
              },
              "requested": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              },
              "submitted": {
                "type": "object"
              },
              "unsupported": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "planned",
                  "submitted",
                  "unsupported",
                  "unverified",
                  "rejected"
                ]
              },
              "provider_confirmed": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "task_elapsed_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "artifact": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "prompt",
              "output",
              "prompt_sha256",
              "output_sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "output_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "evaluation": {
            "type": "object"
          }
        },
        "not": {
          "required": [
            "tokens_per_second"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calibration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "uncontrolled",
            "controlled"
          ]
        },
        "run_mode": {
          "enum": [
            "cold",
            "warm",
            "mixed"
          ]
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "power_mode": {
          "type": "string",
          "minLength": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "comparison_context": {
      "type": "object",
      "description": "Declared workload/model/runtime/execution identities; missing essential controls prevent ranking, not import.",
      "properties": {
        "workload": {
          "type": "object"
        },
        "model": {
          "type": "object"
        },
        "runtime": {
          "type": "object"
        },
        "execution": {
          "type": "object"
        }
      }
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
