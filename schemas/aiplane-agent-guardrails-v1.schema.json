{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplane.dev/schemas/agent-guardrails/v1",
  "title": "aiplane agent guardrails",
  "type": "object",
  "required": ["$schema", "schema_version", "record_type", "render_only", "name", "profile", "framework", "scope", "limits", "adapter", "execution_boundary"],
  "properties": {
    "$schema": {"const": "schemas/aiplane-agent-guardrails-v1.schema.json"},
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "agent_guardrails"},
    "render_only": {"const": true},
    "name": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "framework": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "limits": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "adapter": {"type": "object"},
    "execution_boundary": {"type": "object"}
  },
  "additionalProperties": true
}
