{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplane.dev/schemas/agent-handoff/v1",
  "title": "aiplane agent handoff",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "render_only",
    "name",
    "environment",
    "job",
    "checksums",
    "execution_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/aiplane-agent-handoff-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "agent_handoff"
    },
    "render_only": {
      "const": true
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "record_type"
      ],
      "properties": {
        "record_type": {
          "const": "agent_environment"
        }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "required": [
        "record_type"
      ],
      "properties": {
        "record_type": {
          "const": "agent_job"
        }
      },
      "additionalProperties": true
    },
    "checksums": {
      "type": "object",
      "required": [
        "environment_sha256",
        "job_sha256"
      ],
      "properties": {
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "job_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "execution_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
