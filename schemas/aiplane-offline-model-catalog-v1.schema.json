{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplane.dev/schemas/offline-model-catalog/v1",
  "title": "aiplane offline model catalog",
  "type": "object",
  "required": [
    "contract_version",
    "record_type",
    "models"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "offline_model_catalog"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
