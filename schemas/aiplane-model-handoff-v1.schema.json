{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplane.dev/schemas/model-handoff/v1",
  "title": "aiplane model handoff",
  "type": "object",
  "required": ["$schema", "schema_version", "record_type", "render_only", "profile", "selection", "routing", "calibration_evidence", "runtime_capacity_plan", "execution_boundary", "sha256"],
  "properties": {
    "$schema": {"const": "schemas/aiplane-model-handoff-v1.schema.json"},
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "model_handoff"},
    "render_only": {"const": true},
    "profile": {"type": "string", "minLength": 1},
    "selection": {"type": "object"},
    "routing": {"type": "object"},
    "calibration_evidence": {"type": "object"},
    "runtime_capacity_plan": {"type": "object"},
    "execution_boundary": {"type": "object"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
