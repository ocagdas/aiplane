  "gate_cases": [
    {
      "name": "success",
      "change": null,
      "expected": true
    },
    {
      "name": "failure",
      "change": "failure",
      "expected": false
    },
    {
      "name": "cancelled",
      "change": "cancelled",
      "expected": false
    },
    {
      "name": "skipped",
      "change": "skipped",
      "expected": false
    },
    {
      "name": "missing",
      "change": "missing",
      "expected": false
    },
    {
      "name": "extra_success",
      "change": "extra_success",
      "expected": true
    },
    {
      "name": "extra_failure",
      "change": "extra_failure",
      "expected": false
    }
  ],
  "shared_github_files": [
    ".github/CODEOWNERS",
    ".github/ISSUE_TEMPLATE/bug_report.yml",
    ".github/ISSUE_TEMPLATE/config.yml",
    ".github/ISSUE_TEMPLATE/feature_request.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/dependabot.yml"
  ]
}
