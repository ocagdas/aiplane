{
  "contract_version": "1.0.0",
  "schema_version": 1,
  "required_documents": [
    "README.md",
    "PURPOSE.md",
    "STATUS.md",
    "VALIDATION.md",
    "ROADMAP.md",
    "TODO.md",
    "CONTRIBUTING.md",
