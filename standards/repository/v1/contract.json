    "REPOSITORY_STRUCTURE.md",
    "AGENTS.md",
    "HANDOFF.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "docs/index.md",
    "docs/architecture.md",
    "SUPPORT.md",
    "BRANCHING.md"
  ],
  "required_helpers": [
    "version.py",
    "publish_version.py",
    "build_release.py",
    "ci_gate.py",
    "verify_release.py",
    "check_branch_policy.py"
  ],
  "canonical_workflows": [
    "ci.yml",
    "version.yml",
    "release.yml",
    "verify-release.yml"
