{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "publish": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "version",
    "tag",
    "source_commit",
    "publish"
  ],
  "additionalProperties": true
}
