{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-gate",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "go": {
      "type": "boolean"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "go",
    "commit",
    "run_id",
    "checks"
  ],
  "additionalProperties": true
}
