{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "project",
    "required_jobs",
    "version_mirror",
    "trunk_variable",
    "publication",
    "license_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "required_jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version_mirror": {
      "type": "string",
      "minLength": 1
    },
    "trunk_variable": {
      "const": "REPOSITORY_TRUNK"
    },
    "publication": {
      "enum": [
        "disabled",
        "minor-major",
        "private-minor-major"
      ]
    },
    "license_profile": {
      "type": "string",
      "minLength": 1
    }
  }
}
