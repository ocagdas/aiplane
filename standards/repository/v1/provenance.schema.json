{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provenance",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "version_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "build_kind": {
      "enum": [
        "candidate",
        "release"
      ]
    },
    "dirty": {
      "type": "boolean"
    },
    "distribution": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[^/\\\\:]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "version",
    "tag",
    "source_commit",
    "version_commit",
    "run_id",
    "build_kind",
    "dirty",
    "distribution",
    "artifacts"
  ],
  "additionalProperties": true
}
