{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publication",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "published",
        "unchanged",
        "superseded"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "version_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "required": [
    "schema_version",
    "status",
    "source_commit"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": [
          "version",
          "tag",
          "version_commit"
        ]
      }
    }
  ]
}
